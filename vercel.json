{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/build-site.js",
  "installCommand": "echo 'nothing to install'",
  "outputDirectory": "dist-site",
  "framework": null,
  "headers": [
    {
      "source": "/Build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
